<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Fruit Catch!</title>
  <style>
    :root {
      --sky-top: #6fd3ff;
      --sky-bottom: #dff8ff;
      --grass: #6fdc6b;
      --grass-dark: #42b64f;
      --ink: #183153;
      --panel: rgba(255, 255, 255, 0.9);
      --accent: #ff7a59;
    }

    * { box-sizing: border-box; }

    html, body {
      margin: 0;
      width: 100%;
      height: 100%;
      overflow: hidden;
      font-family: "Trebuchet MS", "Arial Rounded MT Bold", Arial, sans-serif;
      background: linear-gradient(var(--sky-top), var(--sky-bottom));
      color: var(--ink);
      user-select: none;
    }

    body {
      display: grid;
      place-items: center;
    }

    #gameShell {
      position: relative;
      width: min(100vw, 1100px);
      height: min(100vh, 760px);
      min-height: 520px;
      overflow: hidden;
      border-radius: 24px;
      background:
        radial-gradient(circle at 12% 15%, rgba(255,255,255,.95) 0 42px, transparent 44px),
        radial-gradient(circle at 18% 16%, rgba(255,255,255,.92) 0 54px, transparent 56px),
        radial-gradient(circle at 78% 13%, rgba(255,255,255,.9) 0 46px, transparent 48px),
        radial-gradient(circle at 84% 14%, rgba(255,255,255,.88) 0 60px, transparent 62px),
        linear-gradient(var(--sky-top), var(--sky-bottom));
      box-shadow: 0 18px 60px rgba(20, 76, 120, .25);
      touch-action: none;
    }

    #gameShell::after {
      content: "";
      position: absolute;
      left: 0;
      right: 0;
      bottom: 0;
      height: 92px;
      background:
        repeating-linear-gradient(
          18deg,
          transparent 0 26px,
          rgba(255,255,255,.12) 28px 31px
        ),
        linear-gradient(var(--grass), var(--grass-dark));
      border-top: 8px solid rgba(255,255,255,.45);
      z-index: 1;
    }

    #hud {
      position: absolute;
      inset: 18px 18px auto 18px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      gap: 12px;
      z-index: 20;
      pointer-events: none;
    }

    .hudCard {
      background: var(--panel);
      border: 4px solid rgba(255,255,255,.72);
      border-radius: 20px;
      padding: 10px 16px;
      box-shadow: 0 8px 20px rgba(26, 75, 115, .16);
      font-size: clamp(18px, 2.4vw, 30px);
      font-weight: 900;
      letter-spacing: .2px;
      backdrop-filter: blur(6px);
    }

    #score {
      color: #ff5d5d;
      min-width: 160px;
    }

    #lives {
      color: #7d42e8;
      min-width: 170px;
      text-align: right;
    }

    #basket {
      position: absolute;
      left: 50%;
      bottom: 28px;
      width: clamp(120px, 17vw, 180px);
      height: clamp(68px, 9vw, 92px);
      transform: translateX(-50%);
      z-index: 10;
      transition: transform .06s linear;
      filter: drop-shadow(0 10px 8px rgba(59, 41, 15, .18));
    }

    #basket .rim {
      position: absolute;
      left: 4%;
      right: 4%;
      top: 0;
      height: 24%;
      border-radius: 18px;
      background: linear-gradient(#f3b75d, #c97a22);
      border: 4px solid #8e541f;
      z-index: 2;
    }

    #basket .body {
      position: absolute;
      left: 10%;
      right: 10%;
      top: 15%;
      bottom: 0;
      clip-path: polygon(0 0, 100% 0, 85% 100%, 15% 100%);
      border-radius: 0 0 22px 22px;
      background:
        repeating-linear-gradient(90deg, rgba(111,63,24,.2) 0 8px, transparent 8px 24px),
        repeating-linear-gradient(0deg, rgba(111,63,24,.17) 0 6px, transparent 6px 20px),
        linear-gradient(135deg, #ffc96c, #d98a2f);
      border: 4px solid #8e541f;
    }

    .fruit {
      position: absolute;
      top: -100px;
      display: grid;
      place-items: center;
      width: clamp(58px, 7vw, 86px);
      height: clamp(58px, 7vw, 86px);
      font-size: clamp(48px, 6vw, 74px);
      line-height: 1;
      z-index: 8;
      will-change: transform, top;
      filter: drop-shadow(0 8px 5px rgba(40, 79, 95, .18));
      animation: wiggle 1.1s ease-in-out infinite alternate;
    }

    @keyframes wiggle {
      from { transform: rotate(-8deg) scale(1); }
      to   { transform: rotate(8deg) scale(1.05); }
    }

    .pop {
      position: absolute;
      font-size: clamp(24px, 4vw, 44px);
      font-weight: 900;
      color: #ff4f7a;
      text-shadow: 0 3px 0 white;
      pointer-events: none;
      z-index: 30;
      animation: popUp .7s ease-out forwards;
    }

    @keyframes popUp {
      0% { opacity: 0; transform: translate(-50%, 0) scale(.7); }
      25% { opacity: 1; }
      100% { opacity: 0; transform: translate(-50%, -60px) scale(1.25); }
    }

    #overlay {
      position: absolute;
      inset: 0;
      z-index: 50;
      display: grid;
      place-items: center;
      padding: 22px;
      background: rgba(15, 57, 94, .22);
      backdrop-filter: blur(5px);
    }

    #overlay.hidden { display: none; }

    .panel {
      width: min(92%, 520px);
      text-align: center;
      padding: 28px;
      border-radius: 28px;
      background: rgba(255,255,255,.96);
      border: 5px solid rgba(255,255,255,.8);
      box-shadow: 0 20px 60px rgba(33, 64, 89, .28);
    }

    .panel h1 {
      margin: 0 0 10px;
      font-size: clamp(38px, 7vw, 72px);
      color: #ff5d5d;
      line-height: .95;
    }

    .panel p {
      margin: 12px 0 20px;
      font-size: clamp(18px, 2.5vw, 26px);
      line-height: 1.35;
    }

    button {
      border: 0;
      border-radius: 999px;
      padding: 15px 28px;
      font: inherit;
      font-size: clamp(20px, 2.7vw, 28px);
      font-weight: 900;
      color: white;
      background: linear-gradient(180deg, #ff9d49, #ff6b35);
      box-shadow: 0 8px 0 #c9481c, 0 12px 24px rgba(201, 72, 28, .25);
      cursor: pointer;
      transition: transform .15s ease, filter .15s ease;
    }

    button:hover { transform: translateY(-2px) scale(1.02); filter: brightness(1.04); }
    button:active { transform: translateY(5px); box-shadow: 0 3px 0 #c9481c; }

    #hint {
      position: absolute;
      left: 50%;
      bottom: 120px;
      transform: translateX(-50%);
      z-index: 18;
      padding: 8px 15px;
      border-radius: 999px;
      background: rgba(255,255,255,.75);
      font-size: clamp(14px, 1.8vw, 19px);
      font-weight: 800;
      white-space: nowrap;
      transition: opacity .5s ease;
      pointer-events: none;
    }

    @media (max-width: 650px) {
      #gameShell { border-radius: 0; height: 100vh; }
      #hud { inset: 10px 10px auto 10px; }
      .hudCard { padding: 8px 12px; border-radius: 16px; }
      #hint { bottom: 110px; }
    }
  </style>
</head>
<body>
  <main id="gameShell" aria-label="Fruit catching game">
    <div id="hud">
      <div id="score" class="hudCard">Score: 0</div>
      <div id="lives" class="hudCard">Misses: 0 / 3</div>
    </div>

    <div id="hint">Move with ← → or your mouse</div>

    <div id="basket" aria-label="Basket">
      <div class="rim"></div>
      <div class="body"></div>
    </div>

    <section id="overlay">
      <div class="panel">
        <h1>Fruit Catch!</h1>
        <p>Catch the falling fruit. Three misses end the game.</p>
        <button id="startButton">Start Game</button>
      </div>
    </section>
  </main>

  <script>
    (() => {
      const game = document.getElementById("gameShell");
      const basket = document.getElementById("basket");
      const scoreEl = document.getElementById("score");
      const livesEl = document.getElementById("lives");
      const overlay = document.getElementById("overlay");
      const startButton = document.getElementById("startButton");
      const hint = document.getElementById("hint");

      const fruitIcons = ["🍎", "🍌", "🍊", "🍓", "🍉", "🍇", "🍐", "🍒"];
      let fruits = [];
      let score = 0;
      let misses = 0;
      let running = false;
      let basketX = 0;
      let basketSpeed = 8;
      let leftPressed = false;
      let rightPressed = false;
      let lastSpawn = 0;
      let spawnEvery = 800;
      let lastTime = performance.now();
      let hintTimer = null;

      function resetGame() {
        fruits.forEach(f => f.el.remove());
        fruits = [];
        score = 0;
        misses = 0;
        spawnEvery = 800;
        basketX = (game.clientWidth - basket.offsetWidth) / 2;
        updateBasket();
        updateHud();
      }

      function updateHud() {
        scoreEl.textContent = `Score: ${score}`;
        livesEl.textContent = `Misses: ${misses} / 3`;
      }

      function updateBasket() {
        const maxX = game.clientWidth - basket.offsetWidth;
        basketX = Math.max(0, Math.min(maxX, basketX));
        basket.style.left = `${basketX}px`;
        basket.style.transform = "translateX(0)";
      }

      function startGame() {
        resetGame();
        overlay.classList.add("hidden");
        running = true;
        lastSpawn = performance.now();
        lastTime = performance.now();
        hint.style.opacity = "1";
        clearTimeout(hintTimer);
        hintTimer = setTimeout(() => hint.style.opacity = "0", 3500);
      }

      function endGame() {
        running = false;
        overlay.classList.remove("hidden");
        overlay.querySelector("h1").textContent = "Game Over!";
        overlay.querySelector("p").innerHTML = `You caught <strong>${score}</strong> fruit${score === 1 ? "" : "s"}!`;
        startButton.textContent = "Play Again";
      }

      function spawnFruit() {
        const el = document.createElement("div");
        el.className = "fruit";
        el.textContent = fruitIcons[Math.floor(Math.random() * fruitIcons.length)];

        const size = Math.max(58, Math.min(86, game.clientWidth * 0.07));
        const x = Math.random() * Math.max(1, game.clientWidth - size);
        const speed = 150 + Math.random() * 70 + score * 4;

        el.style.left = `${x}px`;
        game.appendChild(el);

        fruits.push({
          el,
          x,
          y: -90,
          speed,
          size
        });
      }

      function makePop(x, y, text) {
        const pop = document.createElement("div");
        pop.className = "pop";
        pop.textContent = text;
        pop.style.left = `${x}px`;
        pop.style.top = `${y}px`;
        game.appendChild(pop);
        setTimeout(() => pop.remove(), 720);
      }

      function catchCheck(fruit) {
        const fruitRect = fruit.el.getBoundingClientRect();
        const basketRect = basket.getBoundingClientRect();

        const horizontalOverlap =
          fruitRect.right > basketRect.left + 12 &&
          fruitRect.left < basketRect.right - 12;

        const verticalCatch =
          fruitRect.bottom >= basketRect.top + 5 &&
          fruitRect.bottom <= basketRect.top + 42;

        return horizontalOverlap && verticalCatch;
      }

      function update(timestamp) {
        const dt = Math.min((timestamp - lastTime) / 1000, 0.035);
        lastTime = timestamp;

        if (running) {
          if (leftPressed) basketX -= basketSpeed * 60 * dt;
          if (rightPressed) basketX += basketSpeed * 60 * dt;
          updateBasket();

          if (timestamp - lastSpawn > spawnEvery) {
            spawnFruit();
            lastSpawn = timestamp;
            spawnEvery = Math.max(360, 800 - score * 12);
          }

          for (let i = fruits.length - 1; i >= 0; i--) {
            const fruit = fruits[i];
            fruit.y += fruit.speed * dt;
            fruit.el.style.top = `${fruit.y}px`;

            if (catchCheck(fruit)) {
              const rect = fruit.el.getBoundingClientRect();
              makePop(rect.left - game.getBoundingClientRect().left + rect.width / 2, rect.top - game.getBoundingClientRect().top, "+1");
              fruit.el.remove();
              fruits.splice(i, 1);
              score++;
              updateHud();
              continue;
            }

            if (fruit.y > game.clientHeight) {
              fruit.el.remove();
              fruits.splice(i, 1);
              misses++;
              updateHud();

              if (misses >= 3) {
                endGame();
                break;
              }
            }
          }
        }

        requestAnimationFrame(update);
      }

      function moveBasketTo(clientX) {
        const rect = game.getBoundingClientRect();
        basketX = clientX - rect.left - basket.offsetWidth / 2;
        updateBasket();
      }

      document.addEventListener("keydown", (e) => {
        if (e.key === "ArrowLeft") {
          leftPressed = true;
          e.preventDefault();
        }
        if (e.key === "ArrowRight") {
          rightPressed = true;
          e.preventDefault();
        }
        if ((e.key === " " || e.key === "Enter") && !running) {
          startGame();
          e.preventDefault();
        }
      });

      document.addEventListener("keyup", (e) => {
        if (e.key === "ArrowLeft") leftPressed = false;
        if (e.key === "ArrowRight") rightPressed = false;
      });

      game.addEventListener("mousemove", (e) => {
        if (running) moveBasketTo(e.clientX);
      });

      game.addEventListener("touchmove", (e) => {
        if (!running) return;
        moveBasketTo(e.touches[0].clientX);
        e.preventDefault();
      }, { passive: false });

      window.addEventListener("resize", updateBasket);
      startButton.addEventListener("click", startGame);

      resetGame();
      requestAnimationFrame(update);
    })();
  </script>
</body>
</html>
